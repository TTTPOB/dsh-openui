root = Card("本地函数演示", [Slider("每期利率 (%)", 0, 10, 0.5, $rate), Grid([Metric("每期付款", @fixed(@pmt($rate / 100, 12, 1200), 2)), Metric("数据中位数", @median([9, 1, 5, 3])), Metric("分组格式", @thousands(1234567.89))]), Row([Text("利率："), Text(@percent($rate / 100, 1))]), Table("函数示例", ["表达式", "结果"], [["sum", @sum([1, 2, 3])], ["clamp", @clamp(12, 0, 10)], ["npv", @fixed(@npv(0.1, [100, 100]), 2)]])])
$rate = 0
